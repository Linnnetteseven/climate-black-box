# ---------------------------------------------------------------------------
# Climate Black Box — environment template.
# Copy to .env and fill in. NEVER commit .env.
# This file documents variable NAMES ONLY. No real secrets here, ever.
# ---------------------------------------------------------------------------

# --- Oracle: local dev (docker compose) ------------------------------------
ORACLE_PASSWORD=change_me_local_only
ORACLE_APP_USER=cbb
ORACLE_APP_PASSWORD=change_me_local_only
ORACLE_DSN=localhost:1521/FREEPDB1

# --- Oracle: Autonomous Database (set these to promote off local) ----------
# When ORACLE_MODE=adb the API uses the wallet + ADB_DSN instead of ORACLE_DSN.
ORACLE_MODE=local
ADB_USER=
ADB_PASSWORD=
ADB_DSN=
# Absolute path to the unzipped instant-client wallet directory.
TNS_ADMIN=

# --- OCI Generative AI (region: eu-frankfurt-1) ----------------------------
OCI_GENAI_ENABLED=false
OCI_COMPARTMENT_ID=
OCI_GENAI_ENDPOINT=https://inference.generativeai.eu-frankfurt-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=
# Standard OCI config file auth. Do not inline the private key.
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# --- CKB testnet -----------------------------------------------------------
CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckb.dev/rpc
# Backend-only. Never expose to apps/web. Never log.
CKB_SIGNER_PRIVATE_KEY=

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8001
API_SHARED_KEY=change_me_local_only
LOG_LEVEL=INFO

# --- Web (public; NEXT_PUBLIC_* reaches the browser — keep it boring) ------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_DEMO_MODE=true
