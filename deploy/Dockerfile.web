# Climate Black Box web.
#
# Multi-stage: the build needs the full toolchain, the runtime needs a Node
# process and the standalone output. Shipping node_modules to production would
# roughly triple the image for no benefit.
FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable

COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY apps/web/ ./
# Next's standalone output bundles only what the server actually imports.
ENV NEXT_OUTPUT=standalone
RUN pnpm build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN useradd --create-home --shell /usr/sbin/nologin cbb

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

USER cbb
EXPOSE 3000
CMD ["node", "server.js"]
